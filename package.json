{
  "name": "linear-simplified",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:console": "npm --workspace apps/console run dev",
    "build:web": "npm --workspace apps/web run build",
    "build:console": "npm --workspace apps/console run build",
    "lint:web": "npm --workspace apps/web run lint",
    "lint:console": "npm --workspace apps/console run lint",
    "test:web": "npm --workspace apps/web run test",
    "test:console": "npm --workspace apps/console run test",
    "test:e2e": "playwright test",
    "measure:usage": "playwright test --config playwright.measure.config.ts",
    "smoke:live": "node scripts/smoke-live.mjs",
    "test:api": "node scripts/python.mjs -m unittest discover -s apps/api/tests && node scripts/python.mjs -m unittest discover -s products -t . -p \"test_*.py\"",
    "dev:api": "node scripts/python.mjs -m uvicorn app.main:app --app-dir apps/api --reload --port 8001",
    "start:api": "node scripts/python.mjs -m uvicorn app.main:app --app-dir apps/api --port 8001"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
