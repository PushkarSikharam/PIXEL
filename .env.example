NEXT_PUBLIC_API_BASE_URL=/api/agent
PIXEL_AGENT_API_BASE_URL=http://127.0.0.1:8001/api

# Deployment identity. Organizations, teams and products are records, never derived from this.
PIXEL_DEPLOYMENT_ID=local-dev
# Seed the synthetic demo organizations declared by product packages. Off unless set to true;
# only local, demo and test environments enable it.
PIXEL_DEMO_SEEDS=true
# Maximum lifetime of one Pixel conversation, in seconds.
PIXEL_SESSION_MAX_AGE_SECONDS=86400
# Product definition used by Edith for navigation around Pixel itself. Leave empty to disable
# the shell assistant without falling back to a shared or synthetic identity.
PIXEL_CONSOLE_DEFINITION=pixel_console

# Auth. Without PIXEL_AUTH_SECRET every API restart invalidates existing logins.
PIXEL_AUTH_SECRET=replace_with_a_long_random_string
# Passwordless demo login for seeded demo identities. Only set this to true for an isolated
# deployment holding synthetic data; it is refused whenever unset. It never signs anyone in as
# an administrator (organization admin or record admin).
PIXEL_SYNTHETIC_DEMO=true
# Optional: identities accepted by the legacy member demo login. The public web app never uses
# this endpoint; it requests a server-allocated private visitor instance instead.
# PIXEL_DEMO_LOGIN_USERS=demo-product-eng
# Optional: restore only the legacy shared member demo after inactivity. Private public demos use
# their own expiry and Reset demo transaction, so production does not need this setting.
# PIXEL_DEMO_IDLE_RESET_MINUTES=20
# Isolated test harnesses only: also allows administrators through the demo login. Never set
# this on a deployment anyone else can reach.
# PIXEL_DEMO_ADMIN_LOGIN=true
# Abuse limits on allocation, chat, speech, record writes and reset (on by default). Only
# isolated test harnesses set this to off.
# PIXEL_RATE_LIMITS=off
# Private public-demo resource limits. Expired instances are pruned in bounded batches. When every
# slot is taken, the instance unused for longest is reclaimed once it has been unused for
# PIXEL_DEMO_INSTANCE_RECLAIM_SECONDS; an instance in use is never evicted.
PIXEL_DEMO_INSTANCE_ACTIVE_LIMIT=1000
PIXEL_DEMO_INSTANCE_RECORD_LIMIT=1000
PIXEL_DEMO_INSTANCE_TTL_SECONDS=86400
PIXEL_DEMO_INSTANCE_IDLE_SECONDS=7200
PIXEL_DEMO_INSTANCE_RECLAIM_SECONDS=900

# Paid providers. Only the API calls them, and every attempt reserves allowance in the
# usage ledger first. Provider keys belong in the API's environment only.
# Kill switch for every paid provider.
PIXEL_PAID_PROVIDERS_ENABLED=true
# Tests and CI set these: any outbound provider request fails loudly, and the API ignores
# developer .env files so runs are identical everywhere.
# PIXEL_BLOCK_EXTERNAL_HTTP=true
# PIXEL_IGNORE_ENV_FILES=true
# Daily quotas per UTC day. Speech units are characters; reasoning units are tokens.
# Realtime voice is disabled.
PIXEL_BUDGET_SPEECH_USER_ATTEMPTS=100
PIXEL_BUDGET_SPEECH_DEPLOYMENT_ATTEMPTS=500
PIXEL_BUDGET_SPEECH_USER_UNITS=25000
PIXEL_BUDGET_SPEECH_DEPLOYMENT_UNITS=125000
PIXEL_BUDGET_SPEECH_MAX_UNITS_PER_ATTEMPT=2000
PIXEL_BUDGET_REASONING_USER_ATTEMPTS=50
PIXEL_BUDGET_REASONING_DEPLOYMENT_ATTEMPTS=250
PIXEL_BUDGET_REASONING_SESSION_ATTEMPTS=25
PIXEL_MAX_ATTEMPTS_PER_REQUEST=2
# Optional hard ceiling on every attempt recorded for this deployment. Use a fresh
# PIXEL_DB_PATH per measurement run.
# PIXEL_TOTAL_ATTEMPT_CAP=20
PIXEL_USAGE_RETENTION_DAYS=90

# Which cloud voices may speak, in order. Azure alone by default; when it cannot answer, the
# browser's own voice takes over. List others only on purpose: azure,gemini,openai
# PIXEL_SPEECH_PROVIDERS=azure

# Microsoft Azure Speech: Edith's voice.
# Create a Speech resource in Azure, rotate any key pasted in chat, then copy the new values locally.
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE_NAME=en-US-AvaMultilingualNeural
AZURE_SPEECH_OUTPUT_FORMAT=audio-24khz-48kbitrate-mono-mp3

# Gemini: reasoning. Speech only if PIXEL_SPEECH_PROVIDERS lists it.
GEMINI_API_KEY=your_gemini_api_key_here
LLM_ENABLED=true
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_MS=6000
# Per-request token limits; optional context is trimmed first to fit the input limit.
LLM_MAX_INPUT_TOKENS=4000
LLM_MAX_OUTPUT_TOKENS=512
LLM_THINKING_LEVEL=minimal
LLM_THINKING_BUDGET=0

# OpenAI: speech only if PIXEL_SPEECH_PROVIDERS lists it.
OPENAI_API_KEY=your_openai_api_key_here

# Customer email sign-in. Never enable shared synthetic-admin login for the console.
# Resend uses HTTPS when PIXEL_SMTP_HOST=smtp.resend.com; other SMTP hosts use TLS on port 465.
# Set PIXEL_AUTH_SECRET to a stable random secret.
PIXEL_EMAIL_LOGIN_ENABLED=false
PIXEL_SELF_SIGNUP_ENABLED=false
PIXEL_SMTP_HOST=
PIXEL_SMTP_USER=
PIXEL_SMTP_PASSWORD=
PIXEL_EMAIL_FROM=
